              "type": "calculated",
              "expression": "DATATABLE(\"Chave\", STRING, \"Label\", STRING, \"Icone\", STRING, \"Cor\", STRING, \"Ordem\", INTEGER, \"Destino\", STRING, {{\"BRAND\", \"FLEET\", \"\", \"#FFFFFF\", 1, \"\"}, {\"SUBTITLE\", \"A N A L Y T I C S\", \"\", \"#B8D6DF\", 2, \"\"}, {\"SECTION\", \"VISÕES ANALÍTICAS\", \"\", \"#B8D6DF\", 3, \"\"}, {\"NAV_01\", \"Visão Executiva\", \"▦\", \"#FFFFFF\", 4, \"825c31049f384847c6ac\"}, {\"NAV_02\", \"Performance\", \"▥\", \"#C7D7E2\", 5, \"2faaefc8084617f504c2\"}, {\"NAV_03\", \"Manutenção\", \"⚙\", \"#C7D7E2\", 6, \"4e55ab6fbe326c42fe0e\"}, {\"NAV_04\", \"Criticidade\", \"△\", \"#C7D7E2\", 7, \"a036aa7e10b56ccb252d\"}, {\"FOOT\", \"CASE DE PORTFÓLIO\", \"\", \"#B8D6DF\", 8, \"\"}, {\"DESCRIPTION\", \"Ativos e produção\", \"\", \"#FFFFFF\", 9, \"\"}, {\"TOKEN_BG\", \"\", \"\", \"#102B3D\", 10, \"\"}, {\"TOKEN_ACTIVE\", \"\", \"\", \"#21586A\", 11, \"\"}, {\"TOKEN_IDLE\", \"\", \"\", \"#173748\", 12, \"\"}, {\"TOKEN_ACCENT\", \"\", \"\", \"#5EEAD4\", 13, \"\"}, {\"TOKEN_HOVER\", \"\", \"\", \"#294F60\", 14, \"\"}})"
            }
          }
        ]
      },
      {
        "name": "_UX_Design",
        "lineageTag": "2880d235-cb55-51ab-9d18-7b13fe504261",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Anchor",
            "dataType": "int64",
            "sourceColumn": "[Anchor]",
            "summarizeBy": "none",
            "lineageTag": "06ae8cdb-44c5-5c07-b30a-d1e2c2002970",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "_UX_Design",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "DATATABLE(\"Anchor\", INTEGER, {{1}})"
            }
          }
        ],
        "measures": [
          {
            "name": "LBL Marca",
            "expression": "LOOKUPVALUE('_UX_Dicionario'[Label], '_UX_Dicionario'[Chave], \"BRAND\")",
            "displayFolder": "01 | Labels",
            "lineageTag": "c1118649-28a2-5fb5-b904-589d71b887a9"
          },
          {
            "name": "LBL Submarca",
            "expression": "LOOKUPVALUE('_UX_Dicionario'[Label], '_UX_Dicionario'[Chave], \"SUBTITLE\")",
            "displayFolder": "01 | Labels",
            "lineageTag": "88e933e8-1ede-585e-99a3-dbe8618dcca6"
          },
          {
            "name": "LBL Secao",
            "expression": "LOOKUPVALUE('_UX_Dicionario'[Label], '_UX_Dicionario'[Chave], \"SECTION\")",
            "displayFolder": "01 | Labels",
            "lineageTag": "dacb3b7e-5b1e-5056-b838-f8ab3187a641"
          },
          {
            "name": "LBL Executivo",
            "expression": "LOOKUPVALUE('_UX_Dicionario'[Label], '_UX_Dicionario'[Chave], \"NAV_01\")",
            "displayFolder": "01 | Labels",
            "lineageTag": "197144d7-c33c-5646-aeae-f3dd8a107b22"
          },
          {
            "name": "LBL Performance",
            "expression": "LOOKUPVALUE('_UX_Dicionario'[Label], '_UX_Dicionario'[Chave], \"NAV_02\")",
            "displayFolder": "01 | Labels",
            "lineageTag": "c2d8a520-9fa8-5060-99d7-734c20380de8"
          },
          {
            "name": "LBL Manutencao",
            "expression": "LOOKUPVALUE('_UX_Dicionario'[Label], '_UX_Dicionario'[Chave], \"NAV_03\")",
            "displayFolder": "01 | Labels",
            "lineageTag": "1e08e44d-78ea-5d5e-b0eb-c8ac31514bf5"
          },
          {
            "name": "LBL Criticidade",
            "expression": "LOOKUPVALUE('_UX_Dicionario'[Label], '_UX_Dicionario'[Chave], \"NAV_04\")",
            "displayFolder": "01 | Labels",
            "lineageTag": "4385f985-0e00-5d08-93d3-033eddc9371f"
          },
