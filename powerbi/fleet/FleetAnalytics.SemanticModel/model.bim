{
  "name": "FleetAnalytics",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "pt-BR",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "DimData",
        "columns": [
          {
            "name": "Data",
            "dataType": "dateTime",
            "sourceColumn": "Data",
            "summarizeBy": "none",
            "isKey": true,
            "formatString": "dd/MM/yyyy",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "Ano",
            "dataType": "int64",
            "sourceColumn": "Ano",
            "summarizeBy": "none"
          },
          {
            "name": "Mes",
            "dataType": "int64",
            "sourceColumn": "Mes",
            "summarizeBy": "none"
          },
          {
            "name": "AnoMes",
            "dataType": "string",
            "sourceColumn": "AnoMes",
            "summarizeBy": "none"
          },
          {
            "name": "Dia",
            "dataType": "int64",
            "sourceColumn": "Dia",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Inicio Mes UX",
            "dataType": "dateTime",
            "expression": "DATE(DimData[Ano], DimData[Mes], 1)",
            "formatString": "MMM yy",
            "summarizeBy": "none",
            "lineageTag": "6a0c3cc0-32ad-5260-bb6b-c76969f2099f"
          }
        ],
        "partitions": [
          {
            "name": "DimData",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Datas = List.Dates(#date(2025, 1, 1), Duration.Days(#date(2027, 1, 1) - #date(2025, 1, 1)), #duration(1,0,0,0)),",
                "    Fonte = Table.FromList(Datas, Splitter.SplitByNothing(), {\"Data\"}),",
                "    Tipos = Table.TransformColumnTypes(Fonte, {{\"Data\", type date}}),",
                "    Ano = Table.AddColumn(Tipos, \"Ano\", each Date.Year([Data]), Int64.Type),",
                "    Mes = Table.AddColumn(Ano, \"Mes\", each Date.Month([Data]), Int64.Type),",
                "    AnoMes = Table.AddColumn(Mes, \"AnoMes\", each Date.ToText([Data], \"yyyy-MM\"), type text),",
                "    Dia = Table.AddColumn(AnoMes, \"Dia\", each Date.Day([Data]), Int64.Type)",
                "in",
                "    Dia"
              ]
            }
          }
        ],
        "dataCategory": "Time"
      },
      {
        "name": "DimEquipamento",
        "columns": [
          {
            "name": "EquipamentoID",
            "dataType": "string",
            "sourceColumn": "EquipamentoID",
            "summarizeBy": "none",
            "isKey": true
          },
          {
            "name": "Equipamento",
            "dataType": "string",
            "sourceColumn": "Equipamento",
            "summarizeBy": "none"
          },
          {
            "name": "Tipo",
            "dataType": "string",
            "sourceColumn": "Tipo",
            "summarizeBy": "none"
          },
          {
            "name": "Modelo",
            "dataType": "string",
            "sourceColumn": "Modelo",
            "summarizeBy": "none"
          },
          {
            "name": "Area",
            "dataType": "string",
            "sourceColumn": "Area",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimEquipamento",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = #table(",
                "        type table [EquipamentoID=text, Equipamento=text, Tipo=text, Modelo=text, Area=text],",
                "        {",
                "            {\"EQ-01\",\"Caminhão 01\",\"Caminhão\",\"CAT 777\",\"Mina Norte\"},",
                "            {\"EQ-02\",\"Caminhão 02\",\"Caminhão\",\"CAT 777\",\"Mina Norte\"},",
                "            {\"EQ-03\",\"Caminhão 03\",\"Caminhão\",\"Komatsu HD785\",\"Mina Sul\"},",
                "            {\"EQ-04\",\"Caminhão 04\",\"Caminhão\",\"Komatsu HD785\",\"Mina Sul\"},",
                "            {\"EQ-05\",\"Escavadeira 01\",\"Escavadeira\",\"CAT 6040\",\"Mina Norte\"},",
                "            {\"EQ-06\",\"Escavadeira 02\",\"Escavadeira\",\"Liebherr R 9400\",\"Mina Sul\"},",
                "            {\"EQ-07\",\"Carregadeira 01\",\"Carregadeira\",\"CAT 994\",\"Pilha\"},",
                "            {\"EQ-08\",\"Trator 01\",\"Trator\",\"CAT D11\",\"Infraestrutura\"}",
                "        })",
                "in",
                "    Fonte"
              ]
            }
          }
        ]
      },
      {
        "name": "FatoOperacao",
        "columns": [
          {
            "name": "Data",
            "dataType": "dateTime",
            "sourceColumn": "Data",
            "summarizeBy": "none",
            "formatString": "dd/MM/yyyy",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "EquipamentoID",
            "dataType": "string",
            "sourceColumn": "EquipamentoID",
            "summarizeBy": "none"
          },
          {
            "name": "ProducaoTon",
            "dataType": "double",
            "sourceColumn": "ProducaoTon",
            "summarizeBy": "sum",
            "formatString": "#,0.0"
          },
          {
            "name": "HorasOperacao",
            "dataType": "double",
            "sourceColumn": "HorasOperacao",
            "summarizeBy": "sum",
            "formatString": "#,0.00"
          },
          {
            "name": "HorasCalendario",
            "dataType": "double",
            "sourceColumn": "HorasCalendario",
            "summarizeBy": "sum",
            "formatString": "#,0.00"
          }
        ],
        "partitions": [
          {
            "name": "FatoOperacao",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Datas = List.Dates(#date(2025, 1, 1), Duration.Days(#date(2027, 1, 1) - #date(2025, 1, 1)), #duration(1,0,0,0)),",
                "    Equipamentos = {\"EQ-01\",\"EQ-02\",\"EQ-03\",\"EQ-04\",\"EQ-05\",\"EQ-06\",\"EQ-07\",\"EQ-08\"},",
                "    Linhas = List.Combine(List.Transform(Datas, (d) => List.Transform(Equipamentos, (e) =>",
                "        let",
                "            Idx = Number.FromText(Text.End(e,2)),",
                "            DiaAno = Date.DayOfYear(d),",
                "            HorasPlanejadas = 15 + Number.Mod(DiaAno * 3 + Idx * 5, 8),",
                "            TemParada = Number.Mod(DiaAno + Idx * 7, 13 + Number.Mod(Idx,4)) = 0,",
                "            HorasParada = if TemParada then 2 + Number.Mod(DiaAno + Idx, 7) else 0,",
                "            Horas = List.Min({HorasPlanejadas, 24 - HorasParada}),",
                "            Producao = Number.Round((110 + Idx * 9 + Number.Mod(DiaAno * 11 + Idx * 17, 75)) * Horas / 20, 1)",
                "        in {d, e, Producao, Number.From(Horas), 24.0}))),",
                "    Fonte = Table.FromRows(Linhas, {\"Data\",\"EquipamentoID\",\"ProducaoTon\",\"HorasOperacao\",\"HorasCalendario\"}),",
                "    Tipos = Table.TransformColumnTypes(Fonte, {{\"Data\", type date},{\"EquipamentoID\", type text},{\"ProducaoTon\", type number},{\"HorasOperacao\", type number},{\"HorasCalendario\", type number}})",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "FatoManutencao",
        "columns": [
          {
            "name": "Data",
            "dataType": "dateTime",
            "sourceColumn": "Data",
            "summarizeBy": "none",
            "formatString": "dd/MM/yyyy",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "EquipamentoID",
            "dataType": "string",
            "sourceColumn": "EquipamentoID",
            "summarizeBy": "none"
          },
          {
            "name": "TipoParada",
            "dataType": "string",
            "sourceColumn": "TipoParada",
            "summarizeBy": "none"
          },
          {
            "name": "HorasManutencao",
            "dataType": "double",
            "sourceColumn": "HorasManutencao",
            "summarizeBy": "sum",
            "formatString": "#,0.00"
          },
          {
            "name": "CustoManutencao",
            "dataType": "double",
            "sourceColumn": "CustoManutencao",
            "summarizeBy": "sum",
            "formatString": "R$ #,0.00"
          }
        ],
        "partitions": [
          {
            "name": "FatoManutencao",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Datas = List.Dates(#date(2025, 1, 1), Duration.Days(#date(2027, 1, 1) - #date(2025, 1, 1)), #duration(1,0,0,0)),",
                "    Equipamentos = {\"EQ-01\",\"EQ-02\",\"EQ-03\",\"EQ-04\",\"EQ-05\",\"EQ-06\",\"EQ-07\",\"EQ-08\"},",
                "    Linhas = List.Combine(List.Transform(Datas, (d) => List.Transform(Equipamentos, (e) =>",
                "        let",
                "            Idx = Number.FromText(Text.End(e,2)),",
                "            DiaAno = Date.DayOfYear(d),",
                "            TemParada = Number.Mod(DiaAno + Idx * 7, 13 + Number.Mod(Idx,4)) = 0,",
                "            Horas = if TemParada then 2 + Number.Mod(DiaAno + Idx, 7) else 0,",
                "            Tipo = if Number.Mod(DiaAno + Idx, 3)=0 then \"Corretiva\" else if Number.Mod(DiaAno + Idx, 3)=1 then \"Preventiva\" else \"Inspeção\",",
                "            Custo = if TemParada then Horas * (850 + Idx * 90) else 0",
                "        in {d, e, Tipo, Number.From(Horas), Number.From(Custo)}))),",
                "    Fonte = Table.FromRows(Linhas, {\"Data\",\"EquipamentoID\",\"TipoParada\",\"HorasManutencao\",\"CustoManutencao\"}),",
                "    Filtrado = Table.SelectRows(Fonte, each [HorasManutencao] > 0),",
                "    Tipos = Table.TransformColumnTypes(Filtrado, {{\"Data\", type date},{\"EquipamentoID\", type text},{\"TipoParada\", type text},{\"HorasManutencao\", type number},{\"CustoManutencao\", type number}})",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "FatoAbastecimento",
        "columns": [
          {
            "name": "Data",
            "dataType": "dateTime",
            "sourceColumn": "Data",
            "summarizeBy": "none",
            "formatString": "dd/MM/yyyy",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "EquipamentoID",
            "dataType": "string",
            "sourceColumn": "EquipamentoID",
            "summarizeBy": "none"
          },
          {
            "name": "Litros",
            "dataType": "double",
            "sourceColumn": "Litros",
            "summarizeBy": "sum",
            "formatString": "#,0.0"
          },
          {
            "name": "CustoCombustivel",
            "dataType": "double",
            "sourceColumn": "CustoCombustivel",
            "summarizeBy": "sum",
            "formatString": "R$ #,0.00"
          }
        ],
        "partitions": [
          {
            "name": "FatoAbastecimento",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Datas = List.Dates(#date(2025, 1, 1), Duration.Days(#date(2027, 1, 1) - #date(2025, 1, 1)), #duration(1,0,0,0)),",
                "    Equipamentos = {\"EQ-01\",\"EQ-02\",\"EQ-03\",\"EQ-04\",\"EQ-05\",\"EQ-06\",\"EQ-07\",\"EQ-08\"},",
                "    Linhas = List.Combine(List.Transform(Datas, (d) => List.Transform(Equipamentos, (e) =>",
                "        let",
                "            Idx = Number.FromText(Text.End(e,2)),",
                "            DiaAno = Date.DayOfYear(d),",
                "            Litros = 950 + Idx * 35 + Number.Mod(DiaAno * 19 + Idx * 31, 420),",
                "            Preco = 5.35 + Number.Mod(DiaAno, 20) / 100",
                "        in {d, e, Number.From(Litros), Number.Round(Litros * Preco, 2)}))),",
                "    Fonte = Table.FromRows(Linhas, {\"Data\",\"EquipamentoID\",\"Litros\",\"CustoCombustivel\"}),",
                "    Tipos = Table.TransformColumnTypes(Fonte, {{\"Data\", type date},{\"EquipamentoID\", type text},{\"Litros\", type number},{\"CustoCombustivel\", type number}})",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "FatoMeta",
        "columns": [
          {
            "name": "Data",
            "dataType": "dateTime",
            "sourceColumn": "Data",
            "summarizeBy": "none",
            "formatString": "dd/MM/yyyy",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "EquipamentoID",
            "dataType": "string",
            "sourceColumn": "EquipamentoID",
            "summarizeBy": "none"
          },
          {
            "name": "MetaProducaoTon",
            "dataType": "double",
            "sourceColumn": "MetaProducaoTon",
            "summarizeBy": "sum",
            "formatString": "#,0.0"
          }
        ],
        "partitions": [
          {
            "name": "FatoMeta",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Datas = List.Dates(#date(2025, 1, 1), Duration.Days(#date(2027, 1, 1) - #date(2025, 1, 1)), #duration(1,0,0,0)),",
                "    Equipamentos = {\"EQ-01\",\"EQ-02\",\"EQ-03\",\"EQ-04\",\"EQ-05\",\"EQ-06\",\"EQ-07\",\"EQ-08\"},",
                "    Linhas = List.Combine(List.Transform(Datas, (d) => List.Transform(Equipamentos, (e) =>",
                "        let Idx = Number.FromText(Text.End(e,2)), Meta = 145 + Idx * 7 in {d, e, Number.From(Meta)}))),",
                "    Fonte = Table.FromRows(Linhas, {\"Data\",\"EquipamentoID\",\"MetaProducaoTon\"}),",
                "    Tipos = Table.TransformColumnTypes(Fonte, {{\"Data\", type date},{\"EquipamentoID\", type text},{\"MetaProducaoTon\", type number}})",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "Medidas",
        "columns": [
          {
            "name": "Chave",
            "dataType": "int64",
            "sourceColumn": "Chave",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Medidas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = #table(type table [Chave=Int64.Type], {{1}})",
                "in",
                "    Fonte"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Produção Total",
            "expression": "SUM(FatoOperacao[ProducaoTon])",
            "formatString": "#,0.0"
          },
          {
            "name": "Horas Calendário",
            "expression": "SUM(FatoOperacao[HorasCalendario])",
            "formatString": "#,0.0"
          },
          {
            "name": "Horas Operação",
            "expression": "SUM(FatoOperacao[HorasOperacao])",
            "formatString": "#,0.0"
          },
          {
            "name": "Horas Manutenção",
            "expression": "IF([Horas Calendário] > 0, COALESCE(SUM(FatoManutencao[HorasManutencao]), 0))",
            "formatString": "#,0.0",
            "description": "Horas de todas as paradas de manutenção, inclusive preventiva e inspeção."
          },
          {
            "name": "Disponibilidade Física %",
            "expression": "DIVIDE([Horas Calendário] - [Horas Manutenção], [Horas Calendário])",
            "formatString": "0.0%"
          },
          {
            "name": "Utilização %",
            "expression": "DIVIDE([Horas Operação], [Horas Calendário] - [Horas Manutenção])",
            "formatString": "0.0%"
          },
          {
            "name": "Produtividade t/h",
            "expression": "DIVIDE([Produção Total], [Horas Operação])",
            "formatString": "#,0.00"
          },
          {
            "name": "Litros Consumidos",
            "expression": "SUM(FatoAbastecimento[Litros])",
            "formatString": "#,0.0"
          },
          {
            "name": "Consumo L/t",
            "expression": "DIVIDE([Litros Consumidos], [Produção Total])",
            "formatString": "#,0.00"
          },
          {
            "name": "Custo Combustível",
            "expression": "SUM(FatoAbastecimento[CustoCombustivel])",
            "formatString": "R$ #,0.00"
          },
          {
            "name": "Custo Manutenção",
            "expression": "SUM(FatoManutencao[CustoManutencao])",
            "formatString": "R$ #,0.00"
          },
          {
            "name": "Custo Total",
            "expression": "[Custo Combustível] + [Custo Manutenção]",
            "formatString": "R$ #,0.00"
          },
          {
            "name": "Custo por Tonelada",
            "expression": "DIVIDE([Custo Total], [Produção Total])",
            "formatString": "R$ #,0.00"
          },
          {
            "name": "Falhas",
            "expression": "IF([Horas Calendário] > 0, COALESCE(CALCULATE(COUNTROWS(FatoManutencao), KEEPFILTERS(FatoManutencao[TipoParada] = \"Corretiva\")), 0))",
            "formatString": "#,0",
            "description": "Proxy sintética: cada evento corretivo representa uma falha; não inclui preventiva ou inspeção."
          },
          {
            "name": "MTTR",
            "expression": "DIVIDE([Horas Manutenção Corretiva], [Falhas])",
            "formatString": "#,0.00",
            "description": "Horas corretivas por falha corretiva; sem falhas retorna BLANK."
          },
          {
            "name": "MTBF",
            "expression": "DIVIDE([Horas Operação], [Falhas])",
            "formatString": "#,0.00",
            "description": "Horas operadas por falha corretiva; proxy de MTBF, sem falhas retorna BLANK."
          },
          {
            "name": "Meta Produção",
            "expression": "SUM(FatoMeta[MetaProducaoTon])",
            "formatString": "#,0.0"
          },
          {
            "name": "Aderência Meta %",
            "expression": "DIVIDE([Produção Total], [Meta Produção])",
            "formatString": "0.0%"
          },
          {
            "name": "Produção Mês Anterior",
            "expression": "CALCULATE([Produção Total], DATEADD(DimData[Data], -1, MONTH))",
            "formatString": "#,0.0"
          },
          {
            "name": "Variação MoM %",
            "expression": "DIVIDE([Produção Total] - [Produção Mês Anterior], [Produção Mês Anterior])",
            "formatString": "0.0%"
          },
          {
            "name": "Produção Ano Anterior",
            "expression": "CALCULATE([Produção Total], DATEADD(DimData[Data], -1, YEAR))",
            "formatString": "#,0.0"
          },
          {
            "name": "Variação YoY %",
            "expression": "DIVIDE([Produção Total] - [Produção Ano Anterior], [Produção Ano Anterior])",
            "formatString": "0.0%"
          },
          {
            "name": "Produção Rolling 30d",
            "expression": "CALCULATE([Produção Total], DATESINPERIOD(DimData[Data], MAX(DimData[Data]), -30, DAY))",
            "formatString": "#,0.0"
          },
          {
            "name": "Produção Rolling 90d",
            "expression": "CALCULATE([Produção Total], DATESINPERIOD(DimData[Data], MAX(DimData[Data]), -90, DAY))",
            "formatString": "#,0.0"
          },
          {
            "name": "Ranking Equipamento",
            "expression": "IF(ISINSCOPE(DimEquipamento[Equipamento]) && NOT ISBLANK([Produção Total]), RANKX(ALLSELECTED(DimEquipamento[Equipamento]), [Produção Total], , DESC, DENSE))",
            "formatString": "#,0",
            "description": "Ranking denso por produção em linha de equipamento; total e ausência de dados retornam BLANK."
          },
          {
            "name": "Participação Perdas %",
            "expression": "DIVIDE([Horas Manutenção], CALCULATE([Horas Manutenção], ALLSELECTED(DimEquipamento[Equipamento])))",
            "formatString": "0.0%"
          },
          {
            "name": "Perdas Acumuladas %",
            "expression": "VAR PerdaAtual = [Horas Manutenção]\nVAR Pares = CALCULATETABLE(ADDCOLUMNS(VALUES(DimEquipamento[Equipamento]), \"@Perda\", CALCULATE([Horas Manutenção])), ALLSELECTED(DimEquipamento[Equipamento]))\nVAR TotalPerdas = SUMX(Pares, [@Perda])\nRETURN IF(HASONEVALUE(DimEquipamento[Equipamento]) && NOT ISBLANK(PerdaAtual), DIVIDE(SUMX(FILTER(Pares, [@Perda] >= PerdaAtual), [@Perda]), TotalPerdas))",
            "formatString": "0.0%",
            "description": "Pareto por horas de manutenção; empates entram juntos, sem usar ranking de criticidade; sem perdas retorna BLANK."
          },
          {
            "name": "Score Disponibilidade",
            "expression": "VAR D = [Disponibilidade Física %] RETURN IF(NOT ISBLANK(D), 1 - D)",
            "formatString": "0.000",
            "description": "Indisponibilidade absoluta."
          },
          {
            "name": "Score Falhas",
            "expression": "VAR Atual = [Falhas] VAR Maximo = MAXX(ALLSELECTED(DimEquipamento[Equipamento]), CALCULATE([Falhas])) RETURN IF(HASONEVALUE(DimEquipamento[Equipamento]) && NOT ISBLANK(Atual), DIVIDE(Atual, Maximo, 0))",
            "formatString": "0.000",
            "description": "Normalização pelo máximo dos ativos selecionados; zero se o máximo for zero."
          },
          {
            "name": "Score Custo",
            "expression": "VAR Atual = [Custo por Tonelada] VAR Maximo = MAXX(ALLSELECTED(DimEquipamento[Equipamento]), CALCULATE([Custo por Tonelada])) RETURN IF(HASONEVALUE(DimEquipamento[Equipamento]) && NOT ISBLANK(Atual), DIVIDE(Atual, Maximo, 0))",
            "formatString": "0.000",
            "description": "Normalização pelo máximo dos ativos selecionados; zero se o máximo for zero."
          },
          {
            "name": "Score Perda",
            "expression": "VAR Atual = [Horas Manutenção] VAR Maximo = MAXX(ALLSELECTED(DimEquipamento[Equipamento]), CALCULATE([Horas Manutenção])) RETURN IF(HASONEVALUE(DimEquipamento[Equipamento]) && NOT ISBLANK(Atual), DIVIDE(Atual, Maximo, 0))",
            "formatString": "0.000",
            "description": "Normalização pelo máximo dos ativos selecionados; zero se o máximo for zero."
          },
          {
            "name": "Índice Criticidade",
            "expression": "VAR Atuais = VALUES(DimEquipamento[Equipamento])\nVAR Pares = CALCULATETABLE(\n    ADDCOLUMNS(VALUES(DimEquipamento[Equipamento]),\n        \"@Disp\", CALCULATE([Disponibilidade Física %]),\n        \"@Custo\", CALCULATE([Custo por Tonelada]),\n        \"@Falhas\", CALCULATE([Falhas]),\n        \"@Perda\", CALCULATE([Horas Manutenção])),\n    ALLSELECTED(DimEquipamento[Equipamento]))\nVAR Validos = FILTER(Pares, NOT ISBLANK([@Disp]) && NOT ISBLANK([@Custo]) && NOT ISBLANK([@Falhas]) && NOT ISBLANK([@Perda]))\nVAR MaxCusto = MAXX(Validos, [@Custo])\nVAR MaxFalhas = MAXX(Validos, [@Falhas])\nVAR MaxPerda = MAXX(Validos, [@Perda])\nVAR Scores = ADDCOLUMNS(Validos, \"@Score\",\n    ROUND(0.35 * (1 - [@Disp]) + 0.25 * DIVIDE([@Custo], MaxCusto, 0) + 0.20 * DIVIDE([@Falhas], MaxFalhas, 0) + 0.20 * DIVIDE([@Perda], MaxPerda, 0), 9))\nVAR Atual = MAXX(FILTER(Scores, DimEquipamento[Equipamento] IN Atuais), [@Score])\nRETURN Atual",
            "formatString": "0.000",
            "description": "Score por equipamento; em agregados, maior score entre os ativos no contexto atual. Pesos fixos 35/25/20/20; normalização relativa à seleção; sem dados válidos retorna BLANK."
          },
          {
            "name": "Ranking Criticidade",
            "expression": "VAR Atuais = VALUES(DimEquipamento[Equipamento])\nVAR Pares = CALCULATETABLE(\n    ADDCOLUMNS(VALUES(DimEquipamento[Equipamento]),\n        \"@Disp\", CALCULATE([Disponibilidade Física %]),\n        \"@Custo\", CALCULATE([Custo por Tonelada]),\n        \"@Falhas\", CALCULATE([Falhas]),\n        \"@Perda\", CALCULATE([Horas Manutenção])),\n    ALLSELECTED(DimEquipamento[Equipamento]))\nVAR Validos = FILTER(Pares, NOT ISBLANK([@Disp]) && NOT ISBLANK([@Custo]) && NOT ISBLANK([@Falhas]) && NOT ISBLANK([@Perda]))\nVAR MaxCusto = MAXX(Validos, [@Custo])\nVAR MaxFalhas = MAXX(Validos, [@Falhas])\nVAR MaxPerda = MAXX(Validos, [@Perda])\nVAR Scores = ADDCOLUMNS(Validos, \"@Score\",\n    ROUND(0.35 * (1 - [@Disp]) + 0.25 * DIVIDE([@Custo], MaxCusto, 0) + 0.20 * DIVIDE([@Falhas], MaxFalhas, 0) + 0.20 * DIVIDE([@Perda], MaxPerda, 0), 9))\nVAR Atual = MAXX(FILTER(Scores, DimEquipamento[Equipamento] IN Atuais), [@Score])\nRETURN IF(HASONEVALUE(DimEquipamento[Equipamento]) && NOT ISBLANK(Atual), 1 + COUNTROWS(DISTINCT(SELECTCOLUMNS(FILTER(Scores, [@Score] > Atual), \"ScoreSuperior\", [@Score]))))",
            "formatString": "#,0",
            "description": "Ranking denso dos scores arredondados a nove casas, maior primeiro. Agregado sem ativo único retorna BLANK."
          },
          {
            "name": "Classe Criticidade",
            "expression": "VAR S = [Índice Criticidade] RETURN IF(HASONEVALUE(DimEquipamento[Equipamento]) && NOT ISBLANK(S), SWITCH(TRUE(), S >= 0.70, \"Crítica\", S >= 0.50, \"Alta\", S >= 0.30, \"Média\", \"Baixa\"))",
            "description": "Classe relativa do equipamento; não classifica agregado ou contexto vazio."
          },
          {
            "name": "Horas Manutenção Corretiva",
            "expression": "IF([Horas Calendário] > 0, COALESCE(CALCULATE(SUM(FatoManutencao[HorasManutencao]), KEEPFILTERS(FatoManutencao[TipoParada] = \"Corretiva\")), 0))",
            "formatString": "#,0.0",
            "description": "Duração apenas de paradas corretivas."
          },
          {
            "name": "Desvio Produção (t)",
            "expression": "IF(NOT ISBLANK([Produção Total]) && NOT ISBLANK([Meta Produção]), [Produção Total] - [Meta Produção])",
            "formatString": "#,0.0",
            "displayFolder": "Data Viz",
            "lineageTag": "928a71dc-a43a-58d0-ad95-4820c9c33c54"
          },
          {
            "name": "Déficit Produção (t)",
            "expression": "VAR D = [Desvio Produção (t)] RETURN IF(D < 0, D)",
            "formatString": "#,0.0",
            "displayFolder": "Data Viz",
            "lineageTag": "da928291-7da2-5d9a-83f4-72613e942044"
          },
          {
            "name": "Superação Produção (t)",
            "expression": "VAR D = [Desvio Produção (t)] RETURN IF(NOT ISBLANK(D) && D >= 0, D)",
            "formatString": "#,0.0",
            "displayFolder": "Data Viz",
            "lineageTag": "9f426bad-4c3f-5c81-a7d7-55c82f141d40"
          },
          {
            "name": "Indisponibilidade %",
            "expression": "VAR D = [Disponibilidade Física %] RETURN IF(NOT ISBLANK(D), 1 - D)",
            "formatString": "0.00%",
            "displayFolder": "Data Viz",
            "lineageTag": "453257ef-ce13-591c-a133-a17722009da2"
          },
          {
            "name": "Componente Indisponibilidade",
            "expression": "IF(HASONEVALUE(DimEquipamento[Equipamento]) && NOT ISBLANK([Índice Criticidade]), 0.35 * [Score Disponibilidade])",
            "formatString": "0.000",
            "displayFolder": "Data Viz",
            "lineageTag": "01d3ba7a-818c-59f9-9c9c-05ddb5c4baa4"
          },
          {
            "name": "Componente Custo",
            "expression": "IF(HASONEVALUE(DimEquipamento[Equipamento]) && NOT ISBLANK([Índice Criticidade]), 0.25 * [Score Custo])",
            "formatString": "0.000",
            "displayFolder": "Data Viz",
            "lineageTag": "2e74ccc3-6e11-5009-af5e-79d2adc937c4"
          },
          {
            "name": "Componente Falhas",
            "expression": "IF(HASONEVALUE(DimEquipamento[Equipamento]) && NOT ISBLANK([Índice Criticidade]), 0.20 * [Score Falhas])",
            "formatString": "0.000",
            "displayFolder": "Data Viz",
            "lineageTag": "480d1f45-7a9a-5ea1-918a-1919f6e301b2"
          },
          {
            "name": "Componente Perdas",
            "expression": "IF(HASONEVALUE(DimEquipamento[Equipamento]) && NOT ISBLANK([Índice Criticidade]), 0.20 * [Score Perda])",
            "formatString": "0.000",
            "displayFolder": "Data Viz",
            "lineageTag": "fbe74ead-1c45-5b1e-8b36-d2e5f0503cf2"
          },
          {
            "name": "Ativos Alta ou Crítica",
            "expression": "VAR Atuais = VALUES(DimEquipamento[Equipamento])\nVAR Pares = CALCULATETABLE(\n    ADDCOLUMNS(VALUES(DimEquipamento[Equipamento]),\n        \"@Disp\", CALCULATE([Disponibilidade Física %]),\n        \"@Custo\", CALCULATE([Custo por Tonelada]),\n        \"@Falhas\", CALCULATE([Falhas]),\n        \"@Perda\", CALCULATE([Horas Manutenção])),\n    ALLSELECTED(DimEquipamento[Equipamento]))\nVAR Validos = FILTER(Pares, NOT ISBLANK([@Disp]) && NOT ISBLANK([@Custo]) && NOT ISBLANK([@Falhas]) && NOT ISBLANK([@Perda]))\nVAR MaxCusto = MAXX(Validos, [@Custo])\nVAR MaxFalhas = MAXX(Validos, [@Falhas])\nVAR MaxPerda = MAXX(Validos, [@Perda])\nVAR Scores = ADDCOLUMNS(Validos, \"@Score\",\n    ROUND(0.35 * (1 - [@Disp]) + 0.25 * DIVIDE([@Custo], MaxCusto, 0) + 0.20 * DIVIDE([@Falhas], MaxFalhas, 0) + 0.20 * DIVIDE([@Perda], MaxPerda, 0), 9))\nRETURN IF(COUNTROWS(Validos) > 0, COALESCE(COUNTROWS(FILTER(Scores, [@Score] >= 0.50)), 0))",
            "formatString": "#,0",
            "displayFolder": "Data Viz",
            "lineageTag": "05899cdb-6722-562f-a27d-d9590d350539"
          },
          {
            "name": "Intervenções",
            "expression": "IF([Horas Calendário] > 0, COALESCE(COUNTROWS(FatoManutencao), 0))",
            "formatString": "#,0",
            "displayFolder": "Data Viz",
            "lineageTag": "00183df6-d345-541c-9da6-deb4dfe3dcb6"
          },
          {
            "name": "Ref Pareto 80%",
            "expression": "IF(NOT ISBLANK([Perdas Acumuladas %]), 0.8)",
            "formatString": "0%",
            "displayFolder": "Data Visualization | Referencias"
          },
          {
            "name": "Ref Meta 100%",
            "expression": "IF(NOT ISBLANK([Aderência Meta %]), 1)",
            "formatString": "0%",
            "displayFolder": "Data Visualization | Referencias"
          },
          {
            "name": "Ref Escala Meta",
            "expression": "IF(NOT ISBLANK([Aderência Meta %]), MAX(1.10, [Aderência Meta %] * 1.05))",
            "formatString": "0%",
            "displayFolder": "Data Visualization | Referencias"
          },
          {
            "name": "Ref Produtividade Frota",
            "expression": "CALCULATE([Produtividade t/h], ALLSELECTED(DimEquipamento[Equipamento]))",
            "formatString": "0.00",
            "displayFolder": "Data Visualization | Referencias"
          },
          {
            "name": "Ref Custo Frota",
            "expression": "CALCULATE([Custo por Tonelada], ALLSELECTED(DimEquipamento[Equipamento]))",
            "formatString": "0.00",
            "displayFolder": "Data Visualization | Referencias"
          },
          {
            "name": "Ref Indisponibilidade Frota",
            "expression": "CALCULATE([Indisponibilidade %], ALLSELECTED(DimEquipamento[Equipamento]))",
            "formatString": "0.00%",
            "displayFolder": "Data Visualization | Referencias"
          },
          {
            "name": "UX Aderencia Status",
            "expression": "VAR A = [Aderência Meta %] RETURN IF(ISBLANK(A), \"Sem dados\", \"Meta 100%  |  \" & FORMAT((A-1)*100, \"+0.00;-0.00;0.00\", \"pt-BR\") & \" p.p.  |  \" & SWITCH(TRUE(), ROUND(A*100,2)<100,\"Abaixo\",ROUND(A*100,2)>100,\"Acima\",\"Na meta\"))",
            "displayFolder": "UX | Apresentacao",
            "lineageTag": "8078e035-0f4f-5982-89c4-3fe571d79e1b"
          },
          {
            "name": "UX Desvio Status",
            "expression": "VAR D = [Desvio Produção (t)] RETURN IF(ISBLANK(D), \"Sem dados\", SWITCH(TRUE(), D<0, \"Déficit frente à meta\", D>0, \"Superação da meta\", \"Na meta planejada\"))",
            "displayFolder": "UX | Apresentacao",
            "lineageTag": "38da7cb3-63c9-5ff3-85a1-4013e06131b7"
          },
          {
            "name": "UX Desvio Cor",
            "expression": "VAR D = [Desvio Produção (t)] RETURN SWITCH(TRUE(), ISBLANK(D), \"#475569\", D<0, \"#B42318\", D>0, \"#166534\", \"#475569\")",
            "displayFolder": "UX | Apresentacao",
            "lineageTag": "e6aa6e93-8c2b-5611-9ae3-103f4883f809"
          },
          {
            "name": "UX Meta Texto",
            "expression": "VAR M = [Meta Produção] RETURN IF(ISBLANK(M), \"Meta sem dados\", \"Meta: \" & FORMAT(M, \"#,0\", \"pt-BR\") & \" t\")",
            "displayFolder": "UX | Apresentacao",
            "lineageTag": "708dd344-4230-5aba-8429-66ebf11b99a3"
          },
          {
            "name": "UX Progresso Meta",
            "expression": "VAR A = [Aderência Meta %] RETURN IF(NOT ISBLANK(A), MAX(0, MIN(1, A)))",
            "displayFolder": "UX | Apresentacao",
            "lineageTag": "2da89afd-8574-5f97-bec3-be1f3727bbba",
            "formatString": "0.00%"
          },
          {
            "name": "UX Restante Meta",
            "expression": "VAR A = [UX Progresso Meta] RETURN IF(NOT ISBLANK(A), 1-A)",
            "displayFolder": "UX | Apresentacao",
            "lineageTag": "7c68e9dd-1b1f-5829-8e45-b97a5a5ebac5",
            "formatString": "0.00%"
          },
          {
            "name": "UX Producao Texto",
            "expression": "VAR P = [Produção Total] RETURN IF(ISBLANK(P), BLANK(), SWITCH(TRUE(), ABS(P)>=1000000, FORMAT(P/1000000,\"0.00\",\"pt-BR\") & \" mi t\", ABS(P)>=1000, FORMAT(P/1000,\"0.0\",\"pt-BR\") & \" mil t\", FORMAT(P,\"#,0.0\",\"pt-BR\") & \" t\"))",
            "displayFolder": "UX | Apresentacao",
            "lineageTag": "e2adae1b-1b34-5e1c-b6b1-0bda6ed31cd2"
          },
          {
            "name": "UX Aderencia Exibicao",
            "expression": "VAR A = [Aderência Meta %] RETURN IF(NOT ISBLANK(A), A)",
            "displayFolder": "UX | Apresentacao",
            "lineageTag": "bdccd2a6-f7c3-5a88-8713-d25d940722a4",
            "formatString": "0.00%"
          },
          {
            "name": "UX Desvio Exibicao",
            "expression": "VAR D = [Desvio Produção (t)] RETURN IF(NOT ISBLANK(D), FORMAT(D,\"+#,0.0;-#,0.0;0.0\",\"pt-BR\") & \" t\")",
            "displayFolder": "UX | Apresentacao",
            "lineageTag": "22462448-a007-5400-adb2-181e9f3c3cd7"
          },
          {
            "name": "UX Disp Contexto",
            "expression": "IF(NOT ISBLANK([Disponibilidade Física %]), \"Disponibilidade física\", \"Sem dados\")",
            "displayFolder": "UX | Apresentacao",
            "lineageTag": "afaf9fc4-ec11-5cda-9938-c490b52d72e2"
          },
          {
            "name": "UX Custo Texto",
            "expression": "IF(NOT ISBLANK([Custo por Tonelada]), \"Por tonelada produzida\", \"Sem dados\")",
            "displayFolder": "UX | Apresentacao",
            "lineageTag": "928fbb28-e91d-5f70-9fbd-c0b1e66327e4"
          },
          {
            "name": "UX Progresso Linear",
            "expression": "VAR A = [UX Progresso Meta] VAR B = MIN(240, MAX(0, ROUND(A * 240, 0))) VAR N = INT(B / 8) VAR R = MOD(B, 8) RETURN IF(ISBLANK(A), BLANK(), REPT(UNICHAR(9608), N) & IF(R > 0, UNICHAR(9616-R), \"\") & REPT(UNICHAR(9617), 30-N-IF(R > 0, 1, 0)))",
            "displayFolder": "UX | Apresentacao",
            "lineageTag": "35b49a55-cf5d-5c7d-98a7-1a76c3523ac8"
          },
          {
            "name": "UX Hero Referencia",
            "expression": "VAR M = [Ref Meta 100%] RETURN IF(ISBLANK(M), \"Sem dados\", \"Meta: \" & FORMAT(M,\"0%\",\"pt-BR\"))",
            "displayFolder": "UX | Apresentacao",
            "lineageTag": "34ecbeab-3030-5840-8dfa-b1323f68667d"
          },
          {
            "name": "UX Hero Delta",
            "expression": "VAR A = [Aderência Meta %] VAR M = [Ref Meta 100%] VAR D = ROUND((A-M)*100,2) RETURN IF(ISBLANK(A)||ISBLANK(M),\"Sem dados\",FORMAT(D,\"+0.00;-0.00;0.00\",\"pt-BR\") & \" p.p. · \" & SWITCH(TRUE(), D<0,\"Abaixo\",D>0,\"Acima\",\"Na meta\"))",
            "displayFolder": "UX | Apresentacao",
            "lineageTag": "56442ad4-f472-59e6-b643-cb2f55b7f6f9"
          },
          {
            "name": "UX Hero Cor",
            "expression": "VAR A = [Aderência Meta %] VAR M = [Ref Meta 100%] VAR D = ROUND((A-M)*100,2) RETURN SWITCH(TRUE(),ISBLANK(A)||ISBLANK(M),\"#C7D7E2\",D<0,\"#FCA5A5\",D>0,\"#86EFAC\",\"#C7D7E2\")",
            "displayFolder": "UX | Apresentacao",
            "lineageTag": "8fc65117-d527-5267-bebc-98d813c86d6d"
          },
          {
            "name": "UX Hero Barra SVG",
            "expression": "VAR A = [UX Progresso Meta] VAR W = FORMAT(268 * A, \"0.000\", \"en-US\") RETURN IF(ISBLANK(A), BLANK(), \"data:image/svg+xml;utf8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22268%22 height=%2212%22 viewBox=%220 0 268 12%22%3E%3Crect width=%22268%22 height=%2212%22 rx=%226%22 fill=%22%23365363%22/%3E%3Crect width=%22\" & W & \"%22 height=%2212%22 rx=%226%22 fill=%22%235EEAD4%22/%3E%3C/svg%3E\")",
            "dataCategory": "ImageUrl",
            "displayFolder": "UX | Apresentacao",
            "lineageTag": "9738b938-e03b-56bb-a832-8d2da9f08846"
          },
          {
            "name": "UX Hero Valor Texto",
            "expression": "VAR A = [Aderência Meta %] RETURN IF(ISBLANK(A), BLANK(), FORMAT(A,\"0.00%\",\"pt-BR\"))",
            "displayFolder": "UX | Apresentacao",
            "lineageTag": "bf8103eb-ef7c-59c9-bcdd-507f08a4ecf9"
          }
        ]
      },
